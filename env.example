# Frontend environment variables — copy to .env.local for local development.
#
# Only NEXT_PUBLIC_* variables reach the browser, and they are inlined at BUILD
# time, not read at runtime. Changing NEXT_PUBLIC_API_URL on a deployed site
# requires a rebuild.
#
# The backend has its own separate file: see backend/env.example.

# Base URL of the Express API. Defaults to http://localhost:5002 when unset
# (see lib/api.ts), so this is optional for local development.
NEXT_PUBLIC_API_URL=http://localhost:5002
