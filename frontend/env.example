# Frontend environment variables — copy to frontend/.env.local
#
# Only NEXT_PUBLIC_* variables reach the browser, and they are inlined at BUILD
# time, not read at runtime. Changing one on a deployed site requires a rebuild.
# CLERK_SECRET_KEY is server-only: Next.js reads it in middleware, and it is
# never included in the client bundle.
#
# The backend has its own separate file: see backend/env.example.

# ── API ─────────────────────────────────────────────────────────────────
# Base URL of the Express API. Optional locally — lib/api.ts falls back to
# http://localhost:5002. Required in production.
NEXT_PUBLIC_API_URL=http://localhost:5002

# ── Clerk authentication (required) ─────────────────────────────────────
# Both keys come from https://dashboard.clerk.com → API keys.
# Development instances issue pk_test_… / sk_test_… ; production issues
# pk_live_… / sk_live_… . The same CLERK_SECRET_KEY must also be set on the
# backend, which verifies the session tokens this app sends it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Point Clerk at the in-app sign-in/sign-up pages. Without these, a protected
# route redirects to Clerk's hosted account portal instead of app/signin.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
