# Backend Environment Variables

# Server Configuration
PORT=5002
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/hackforge

# AI API Keys — xAI Grok. Create one at https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# Optional. Defaults to grok-3. List what your key can reach with:
#   curl https://api.x.ai/v1/models -H "Authorization: Bearer $XAI_API_KEY"
GROK_MODEL=grok-3

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# API Configuration
API_VERSION=v1
MAX_REQUEST_SIZE=10mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security — REQUIRED for authentication.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, the server generates a random secret per process, which signs users
# out on every restart. Never deploy without setting this.
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sentry Configuration (Optional)
SENTRY_DSN=https://your-sentry-dsn@your-org.ingest.sentry.io/your-project 