# Backend environment variables — copy to backend/.env for local development.
#
# Every variable listed here is actually read by the code. The rate limits are
# hardcoded in routes/*.js and the body-size limit in server.js.

# ── Server ──────────────────────────────────────────────────────────────
PORT=5002
NODE_ENV=development

# CORS allow-list for the frontend. Comma-separated for multiple origins:
#   FRONTEND_URL=http://localhost:3000,https://hackforge.vercel.app
# Any localhost/LAN origin is also accepted while NODE_ENV is not production.
FRONTEND_URL=http://localhost:3000

# ── Database (optional) ─────────────────────────────────────────────────
# Without this the API still generates code, but accounts and saved projects
# return 503. Use a MongoDB Atlas connection string in production.
MONGODB_URI=mongodb://localhost:27017/hackforge

# ── AI provider (required for code generation) ──────────────────────────
# Groq (groq.com) and xAI (x.ai) share an OpenAI-compatible API. The provider is
# detected from the key prefix:
#   gsk_…  -> Groq   (https://console.groq.com/keys)
#   xai-…  -> xAI    (https://console.x.ai)
GROQ_API_KEY=your_groq_api_key_here

# Optional. Defaults to llama-3.3-70b-versatile on Groq, grok-3 on xAI.
# List what your key can reach with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# AI_MODEL=llama-3.3-70b-versatile

# Optional. Force a provider instead of inferring it from the key: groq | xai
# AI_PROVIDER=groq

# ── Clerk authentication (required) ─────────────────────────────────────
# The API does not issue or manage sessions — Clerk does. This key lets
# @clerk/express verify the session token the frontend sends in the
# Authorization header. Use the SAME secret key as the frontend.
# From https://dashboard.clerk.com → API keys.
# Without it every request is treated as signed out and the project routes
# answer 401.
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ── Cache (optional) ────────────────────────────────────────────────────
# Set REDIS_URL, or the REDIS_HOST/PORT/PASSWORD trio. When neither is set the
# cache is disabled and the API runs normally without it.
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
